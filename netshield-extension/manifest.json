{
  "manifest_version": 3,
  "name": "NetShield Web",
  "version": "1.2.1",
  "description": "Ẩn quảng cáo Facebook (Được tài trợ), YouTube, Zing MP3, Spotify Web, báo Việt Nam và vượt màn hình chống Adblock. An toàn tuyệt đối cho Thuế, HĐĐT, Chữ ký số và Ngân hàng.",
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NetShield Web",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/cosmetic.css"],
      "js": ["content/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
